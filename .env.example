# --- Used directly by the app (bare `uvicorn` run, or inside the container) ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=canteen_coupon

LOCAL_NETWORK_HOST=0.0.0.0
LOCAL_NETWORK_PORT=8000

# Timezone and UPI details are NOT set here — they're admin-editable at
# runtime via the Settings page in the dashboard (PATCH /settings), stored
# in the database alongside grace allowance and meal windows. Set them there
# after first startup, not in this file.

BILLS_OUTPUT_DIR=generated_bills
QR_OUTPUT_DIR=generated_qr

LOGS_DIR=logs

# Auth bootstrap — creates one admin account the FIRST time the users
# collection is empty; ignored after that (manage users from the Users page
# from then on). If INITIAL_ADMIN_PASSWORD is left blank, a random one is
# generated and printed to the log at startup instead — check logs/app.log.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=
SESSION_TTL_HOURS=12

# --- Used by docker-compose.yml only (ignored for a bare local run) ---
# MONGO_URI above is overridden inside the app container using these two —
# set a real password before running `docker compose up` in production
# (e.g. `openssl rand -base64 24`). mongo itself is initialized with the
# same credentials, so they only need to be set once, here.
MONGO_ROOT_USER=canteen_admin
MONGO_ROOT_PASSWORD=change-me-before-deploying

# Host port nginx binds to. Change if 80 is already taken on the host.
HTTP_PORT=80

# Gunicorn worker count and log verbosity for the app container.
GUNICORN_WORKERS=2
LOG_LEVEL=info
